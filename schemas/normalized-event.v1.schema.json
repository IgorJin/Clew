{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/normalized-event.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "type", "payload", "at"],
  "properties": {
    "version": { "const": 1 },
    "task_id": { "type": "string" },
    "type": { "type": "string" },
    "payload": { "type": "object" },
    "at": { "type": "string", "format": "date-time" }
  }
}
