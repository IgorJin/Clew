{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/execution-brief.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task",
    "run",
    "role",
    "assignment",
    "context",
    "requiredEvidence",
    "permissions"
  ],
  "properties": {
    "version": { "const": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "acceptance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "criterion": { "type": "string", "minLength": 1 }
            }
          }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "runId", "attempt"],
      "properties": {
        "stageId": { "type": "string", "minLength": 1 },
        "runId": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "role": { "enum": ["worker", "reviewer", "architect", "integration", "qa"] },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal"],
      "properties": { "goal": { "type": "string", "minLength": 1 } }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewFindings", "evidence", "revision", "dependencyRevisions"],
      "properties": {
        "reviewFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "criterion", "reason"],
            "properties": {
              "severity": { "type": "string", "minLength": 1 },
              "criterion": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence": { "type": "array" },
        "revision": { "type": ["string", "null"] },
        "dependencyRevisions": { "type": "array", "items": { "type": "string" } },
        "scout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "contextId", "checksum", "task", "source", "status", "sections"],
          "properties": {
            "version": { "const": 1 },
            "contextId": { "type": "string", "minLength": 1 },
            "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "task": {
              "type": "object",
              "additionalProperties": false,
              "required": ["taskId", "projectId", "contractFingerprint"],
              "properties": {
                "taskId": { "type": "string", "minLength": 1 },
                "projectId": { "type": "string", "minLength": 1 },
                "contractFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repositoryId", "revision", "scope", "generatedAt", "attemptId"],
              "properties": {
                "repositoryId": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 7 },
                "generatedAt": { "type": "string", "format": "date-time" },
                "attemptId": { "type": "string", "minLength": 1 },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["paths"],
                  "properties": {
                    "paths": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            },
            "status": { "enum": ["complete", "partial"] },
            "sections": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "components": { "type": "array" },
                "relationships": { "type": "array" },
                "checks": { "type": "array" },
                "observations": { "type": "array" },
                "unknowns": { "type": "array" },
                "omissions": { "type": "array" }
              }
            }
          }
        }
      }
    },
    "requiredEvidence": { "type": "array" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write"],
      "properties": { "write": { "type": "boolean" } }
    }
  }
}
