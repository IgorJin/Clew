{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/scout-context-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "attemptId", "task", "repository", "scope"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "#/$defs/identifier" },
    "attemptId": { "$ref": "#/$defs/identifier" },
    "task": { "$ref": "#/$defs/taskIdentity" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "revision"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "scope": { "$ref": "#/$defs/scope" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$).+)$"
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "projectId", "contractFingerprint"],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "contractFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    }
  }
}
