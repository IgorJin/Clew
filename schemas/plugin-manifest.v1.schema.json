{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/plugin-manifest.v1.schema.json",
  "title": "Clew plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "apiVersion",
    "extensionPoints",
    "configSchema",
    "scope",
    "resources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^clew\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "apiVersion": { "type": "string", "const": "1" },
    "extensionPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "version"],
        "properties": {
          "point": { "type": "string", "enum": ["AgentRuntime", "TelemetrySink"] },
          "version": { "type": "string", "const": "1" }
        }
      }
    },
    "configSchema": { "type": "object" },
    "scope": { "type": "string", "enum": ["controller", "execution-host"] },
    "resources": { "type": "object" }
  }
}
