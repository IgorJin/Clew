{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/execution-plan.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["parallelizable", "stages"],
  "properties": {
    "parallelizable": { "type": "boolean" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
          "goal": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["worker", "integration", "qa"] },
          "harness": { "enum": ["fake", "codex", "opencode"] },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
