{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/repository-context.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contextId",
    "task",
    "source",
    "components",
    "relationships",
    "checks",
    "observations",
    "unknowns",
    "omissions",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contextId": { "$ref": "#/$defs/identifier" },
    "task": { "$ref": "#/$defs/taskIdentity" },
    "source": { "$ref": "#/$defs/source" },
    "components": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/component" }
    },
    "relationships": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/check" }
    },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/observation" }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/unknown" }
    },
    "omissions": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/omission" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": { "status": { "const": "complete" } },
            "required": ["status"]
          }
        }
      },
      "then": { "properties": { "omissions": { "maxItems": 0 } } },
      "else": { "properties": { "omissions": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?![\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$).+)$"
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 512 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "projectId", "contractFingerprint"],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "contractFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "revision", "scope", "generatedAt", "attemptId"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/revision" },
        "scope": { "$ref": "#/$defs/scope" },
        "generatedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "attemptId": { "$ref": "#/$defs/identifier" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "revision": { "$ref": "#/$defs/revision" },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "symbol": { "$ref": "#/$defs/shortText" }
      },
      "dependentRequired": { "lineEnd": ["lineStart"] }
    },
    "references": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "purpose", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "symbol": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/evidenceReferences" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceComponentId", "targetComponentId", "kind", "description", "references"],
      "properties": {
        "sourceComponentId": { "$ref": "#/$defs/identifier" },
        "targetComponentId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/evidenceReferences" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "args", "reason", "references"],
      "properties": {
        "kind": { "const": "recommended" },
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "cwd": { "$ref": "#/$defs/repositoryPath" },
        "reason": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/evidenceReferences" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement", "references"],
      "properties": {
        "kind": { "enum": ["observed", "inferred"] },
        "statement": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/references" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "observed" } } },
          "then": { "properties": { "references": { "minItems": 1 } } }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "reason", "references"],
      "properties": {
        "question": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "references": { "$ref": "#/$defs/references" }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "detail"],
      "properties": {
        "reason": {
          "enum": [
            "size_limit",
            "scope_limit",
            "timeout",
            "access_denied",
            "unsupported_file",
            "other"
          ]
        },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness"],
      "properties": {
        "harness": { "$ref": "#/$defs/shortText" },
        "sessionId": { "$ref": "#/$defs/identifier" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime", "checksum"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "runtime": { "$ref": "#/$defs/runtime" },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
