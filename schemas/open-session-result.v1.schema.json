{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clew.local/schemas/open-session-result.v1.schema.json",
  "type": "object",
  "required": ["version", "taskId", "role", "harness", "sessionId", "state"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "stageId": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "role": { "enum": ["architect", "worker", "reviewer", "qa"] },
    "harness": { "enum": ["codex", "opencode", "fake"] },
    "sessionId": { "type": "string", "minLength": 1 },
    "turnId": { "type": ["string", "null"] },
    "state": { "enum": ["opened", "resumed", "unavailable"] },
    "capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
